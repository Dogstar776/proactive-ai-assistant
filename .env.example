# proactive-ai-assistant 环境变量示例
# 复制为 .env 后填写真实值；.env 已在 .gitignore，永不提交。
# 注意：不填任何值时系统以 MockLLM 模式完整运行（开源复现默认路径）。

# ── LLM Provider（三选一，或都不选=MockLLM） ──
# 选项 A：OpenAI 兼容端点（含 DeepSeek 等）
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# 选项 B：本地 Ollama
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b

# 选项 C：MockLLM（默认，无需密钥）
# LLM_PROVIDER=mock

# ── 认知周期预算（论文 4.4 / ADR-0005） ──
DEEP_CYCLES_PER_DAY=2
DAILY_TOKEN_BUDGET=200000
LIGHT_OBSERVE_INTERVAL_MINUTES=15

# ── 服务 ──
API_HOST=127.0.0.1
API_PORT=8787
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
LOG_LEVEL=INFO
DATA_DIR=./data

# ── 远程访问（安卓 APK 接管；留空=本地单用户不鉴权） ──
# 设置后 /api/v1/* 要求 X-API-Key 请求头（/health 保持开放供连通性测试）
# API_KEY=你的密钥
# 手机访问时启动加 --host 0.0.0.0，地址填电脑局域网 IP

# ── 采集源（逗号分隔；本地优先，ADR-0004） ──
# 全部留空 = 自动挂载 assistant/fixtures 下的演示连接器（开箱即用，演示数据）
# 示例：COLLECTOR_ICS_PATHS=C:/Users/me/calendar.ics
#       COLLECTOR_NOTES_PATHS=D:/notes
#       COLLECTOR_RSS_URLS=https://example.com/feed.xml
COLLECTOR_ICS_PATHS=
COLLECTOR_NOTES_PATHS=
COLLECTOR_RSS_URLS=
CONSENT_GRANTED_BY=owner
